  "version_file": "package.json",
  "inputs": [
    "src",
    "public",
    "preload",
    "index.html",
    "browser.html",
    "plugin.json",
    "package.json",
    "tsconfig.json",
    "tsconfig.node.json",
    "vite.config.ts",
    "vite.debug.ts",
    "uno.config.ts",
    "postcss.config.js",
    "tailwind.config.js",
    "scripts/utools-build.js",
    ".github/scripts/stable-release.py",
    ".github/stable-release.json",
    ".github/workflows/daily-stable.yml"
  ],
  "assets": [
    {
      "name": "goose-mark-utools-plugin.zip",
      "parts": [
        {
          "path": "dist"
        }
      ]
